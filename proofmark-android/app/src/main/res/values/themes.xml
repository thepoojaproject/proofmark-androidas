<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- This is the theme set on the activity. It extends the Splash Screen
         API's base theme so the splash shows instantly with no white flash,
         then SplashScreen.installSplashScreen() in MainActivity switches to
         Theme.Proofmark.Main once the WebView content is ready. -->
    <style name="Theme.Proofmark" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.Proofmark.Main</item>
    </style>

    <style name="Theme.Proofmark.Main" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_accent_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_coral</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

</resources>
